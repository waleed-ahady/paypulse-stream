# Stripe test secret key used only by scripts/create_test_payment.py.
STRIPE_SECRET_KEY=change_me_locally

# Stripe CLI prints this secret after `stripe listen` starts.
STRIPE_WEBHOOK_SECRET=change_me_locally

# Kafka settings used by FastAPI and Spark inside the Docker network.
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_TOPIC=payment_events

# PostgreSQL settings shared by PostgreSQL, Spark, and Streamlit.
POSTGRES_DB=paypulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_locally
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Dashboard settings.
DASHBOARD_REFRESH_SECONDS=5
DASHBOARD_DEFAULT_CURRENCY=gbp

# Application settings.
LOG_LEVEL=INFO
